# LunarSerpent — local configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed:
# a credential in version control persists in history long after it stops being
# appropriate to share.

# Cesium ion access token, for the "Terrain" renderer (Cesium Moon Terrain).
# Create a free one at https://ion.cesium.com/tokens and scope it to asset
# 2684829 only. Without this the Terrain view reports itself unavailable and
# the Classic globe is unaffected.
CESIUM_ION_TOKEN=

# Optional overrides
# LUNARSERPENT_DATA_ROOT=D:\Lunar_Serpent\data\raw
# LUNARSERPENT_HOST=127.0.0.1
# LUNARSERPENT_PORT=8765
